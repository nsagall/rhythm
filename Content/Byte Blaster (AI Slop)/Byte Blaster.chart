[song]
title = Byte Blaster (AI Slop)
bpm = 150
time_signature = 4/4
start_tolerance_ms = 120
release_tolerance_ms = 250

[clip]
display_name = Drum Intro
name = drum_intro
hits_required = 6

[clip]
display_name = Full Beat
name = drums
volume = 0.85

[clip]
display_name = Bass
name = bass
hits_required = 6
init_volume = 0.5
volume = 0.55

[clip]
display_name = Arp
name = arp
hits_required = 6
init_volume = 0.75
volume = 0.8

[clip]
display_name = Lead
name = lead
hits_required = 6
init_volume = 0.7
volume = 0.75

[clip]
display_name = Bell Bridge
name = bell_bridge
hits_required = 6
learn_mode = dontfail
release_tolerance_ms = 600

[clip]
display_name = Drums 2
name = drums_2
hits_required = 8

[clip]
display_name = Lead 2
name = lead_2
hits_required = 6
init_volume = 0.7
volume = 0.75

[learn]
clip = drum_intro

[reset]

[background]
clip = drums

[learn]
clip = bass

[learn]
clip = arp

[learn]
clip = lead

[reset]

[break]
clip = arp
loop_count = 3

[background]
clip = arp

[learn]
clip = bell_bridge

[reset]

[background]
clip = drums_2

[background]
clip = bass

[learn]
clip = lead_2

[break]
clip = arp

[background]
clip = arp

[learn]
clip = drum_intro
