[song]
title = Quiet Hours
bpm = 84
time_signature = 4/4
start_tolerance_ms = 130
release_tolerance_ms = 260

[clip]
display_name = Drum Intro
name = drum_intro
hits_required = 6

[clip]
display_name = Full Beat
name = drums
volume = 0.7

[clip]
display_name = Bass
name = bass
hits_required = 6
init_volume = 0.5
volume = 0.55

[clip]
display_name = Pad
name = pad
hits_required = 4
init_volume = 0.45
volume = 0.5

[clip]
display_name = Lead
name = lead
hits_required = 6
init_volume = 0.7
volume = 0.75

[clip]
display_name = Bridge
name = bridge
hits_required = 6
learn_mode = dontfail
release_tolerance_ms = 700

[clip]
display_name = Drums 2
name = drums_2
volume = 0.7

[clip]
display_name = Lead 2
name = lead_2
hits_required = 6
init_volume = 0.7
volume = 0.75

[learn]
clip = drum_intro

[reset]

[background]
clip = drums

[learn]
clip = bass

[learn]
clip = pad

[learn]
clip = lead

[reset]

[break]
clip = pad
loop_count = 3

[background]
clip = pad

[learn]
clip = bridge

[reset]

[background]
clip = drums_2

[background]
clip = bass

[learn]
clip = lead_2

[break]
clip = pad

[background]
clip = pad

[learn]
clip = drum_intro
