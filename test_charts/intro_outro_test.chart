[song]
title = Intro/Outro Test
bpm = 100
time_signature = 4/4

[instrument]
name = Bass Drum
file = stems\bass_drum.wav
pattern = quarter
hits_required = 4
tolerance_ms = 150
intro_bars = 2

[instrument]
name = Snare
file = stems\snare.wav
pattern = quarter every:2 offset:1
hits_required = 4
tolerance_ms = 150
outro_loops = 2

[instrument]
name = Hi-Hat
file = stems\hihat.wav
pattern = bar beats:1,1.5,2,2.5,3,3.5,4,4.5
hits_required = 8
tolerance_ms = 130
