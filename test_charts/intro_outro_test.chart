[song]
title = Intro/Outro Test
bpm = 100
time_signature = 4/4
start_tolerance_ms = 150
release_tolerance_ms = 150

[clip]
display_name = Bass Drum
name = bass_drum
hits_required = 4
intro_bars = 2

[clip]
display_name = Snare
name = snare
hits_required = 4
outro_loops = 2

; Deliberately overrides the song's default tolerance - proves a clip-level
; start_tolerance_ms/release_tolerance_ms actually takes effect instead of
; silently falling back to the global value.
[clip]
display_name = Hi-Hat
name = fast_test_hat
hits_required = 8
start_tolerance_ms = 130
release_tolerance_ms = 130

[section]
clip = bass_drum
play_mode = learn

[section]
clip = snare
play_mode = learn

[section]
clip = fast_test_hat
play_mode = learn
