[song]
title = Intro/Outro Test
bpm = 100
time_signature = 4/4
start_tolerance_ms = 150
release_tolerance_ms = 150

[clip]
name = Bass Drum
filename = bass_drum
hits_required = 4
intro_bars = 2

[clip]
name = Snare
filename = snare
hits_required = 4
outro_loops = 2

; Deliberately overrides the song's default tolerance - proves a clip-level
; start_tolerance_ms/release_tolerance_ms actually takes effect instead of
; silently falling back to the global value.
[clip]
name = Hi-Hat
filename = fast_test_hat
hits_required = 8
start_tolerance_ms = 130
release_tolerance_ms = 130

[section]
clip = Bass Drum
play_mode = learn

[section]
clip = Snare
play_mode = learn

[section]
clip = Hi-Hat
play_mode = learn
