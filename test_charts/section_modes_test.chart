[song]
title = Section Modes Test
bpm = 100
time_signature = 4/4
start_tolerance_ms = 150
release_tolerance_ms = 150

[clip]
display_name = Click
name = fast_test_hat
hits_required = 4

[clip]
display_name = Pad
name = bass_drum
hits_required = 1

; Queues Pad to start the instant the next section (Click, learn) begins -
; purely additive, never blocks, never itself becomes the "current" section.
[background]
clip = bass_drum
loop_count = 2

; Pad starts here, playing alongside Click while it's learned.
[learn]
clip = fast_test_hat

; Reset: a silence gate that stops everything (including Pad, if it's
; still playing) and advances.
[reset]

; Break reusing the same Pad clip that was played as a background layer
; earlier - proves clips can be reused across different block kinds.
[break]
clip = bass_drum
loop_count = 1

; Second learn section reusing Click - proves a clip can be learned more
; than once in the same chart.
[learn]
clip = fast_test_hat
